  accountabilityType: 'real' | 'personal' | 'none';
  witnessPhone?: string;
  witnessName?: string;
  witnessRelationship?: string;
  witnessConnectionId?: string;
  personalWitnessName?: string;
  personalWitnessPhotoUrl?: string;
  isActive: boolean;
  currentStreak: number;
  longestStreak: number;
  createdAt: string;
  updatedAt: string;
}

interface TaskEvent {
  id: string;
  taskId: string;
  userId: string;
  scheduledFor: string;
  status: 'pending' | 'done' | 'snoozed' | 'in_progress' | 'struggled' | 'missed';
  respondedAt?: string;
  snoozeCount: number;
  strugglingReason?: string;
  strugglingNote?: string;
  // Timer fields (timed tasks only)
  startedAt?: string;
  completedAt?: string;
  pausedDurationSeconds: number;
  actualDurationSeconds?: number;
  originalDurationMinutes?: number;
  extensionsUsed: number;
  totalExtensionSeconds: number;
  timerCompleted?: boolean;
  createdAt: string;
}

// Extension tier helper (compute from task.durationMinutes)
function getExtensionTier(durationMinutes: number): {
  options: number[];     // extension options in minutes
  maxExtensions: number;
} {
  if (durationMinutes < 30) {
    return { options: [5, 10], maxExtensions: 2 };
  } else if (durationMinutes <= 120) {
    return { options: [10, 15], maxExtensions: 3 };
  } else {
    return { options: [15, 30], maxExtensions: 2 };
  }
}
